# Copy thanh .env roi chinh. File .env bi gitignore, KHONG commit.
# Cac gia tri mac dinh duoi day khop voi docker-compose.yml o goc repo.

# Port API (macOS: 5000 bi AirPlay chiem)
PORT=4000

# Postgres. Production: dat mat khau manh, KHONG dung store/store
DATABASE_URL=postgres://store:store@localhost:5432/store
# Dedicated disposable test database only; NEVER point at production.
TEST_DATABASE_URL=postgres://store:store@localhost:5432/store_test

# Cac origin duoc gui request ghi (chong CSRF), phan cach bang dau phay.
# Production: dat dung domain web, vi du https://library.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production => cookie dang nhap co co Secure (bat buoc HTTPS). De trong khi dev.
# NODE_ENV=production

# Server-only JWT HS256 signing key: exactly 32 random bytes encoded as base64.
# Generate with node crypto.randomBytes(32).toString('base64'); never expose to clients.
# Preserve across restarts; changing it requires users to log in again.
JWT_SECRET=

# Thu muc du lieu (de trong = mac dinh <repo>/source/3DSMOOD va <repo>/storage)
# SOURCE_DIR=
# STORAGE_DIR=

# Licensing: two DISTINCT CSPRNG secrets, each exactly 32 bytes encoded as base64.
# Generate locally using node crypto.randomBytes(32).toString('base64'); never commit.
# Back these up securely: changing either breaks verification/decryption of existing keys.
LICENSE_HMAC_SECRET=
LICENSE_ENCRYPTION_KEY=
# Comma-separated UUIDs from users.id; empty means no administrator can issue/revoke.
LICENSE_ADMIN_USER_IDS=

# Single Lifetime product; exactly 2000 VND, controlled by the server.
LICENSE_PRICE_VND=2000
PUBLIC_BASE_URL=http://localhost:5173
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/license
PAYOS_CANCEL_URL=http://localhost:5173/license
# Public HTTPS endpoint; registration is a separate explicit operator action.
PAYOS_WEBHOOK_URL=

# Default dev bind is loopback. Put production behind an HTTPS reverse proxy.
HOST=127.0.0.1
# Only when behind a known reverse proxy, e.g. 127.0.0.1/32,::1/128.
# Keep empty when directly exposed. Restrict upstream ingress at the firewall.
TRUST_PROXY=
# Production runs migrations separately with a migration role; dev runs on startup.
# RUN_MIGRATIONS=false

CATALOG_PROVIDER=google_drive
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1qQgoy1yLQuaO9S-yT_ZT7nai6EAA4OwA?usp=drive_link
GOOGLE_DRIVE_FOLDER_ID=1qQgoy1yLQuaO9S-yT_ZT7nai6EAA4OwA
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_SYNC_INTERVAL_MINUTES=30
GOOGLE_DRIVE_PREVIEW_CACHE_DIR=./storage/drive-previews
