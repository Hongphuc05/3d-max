# Copy thanh .env roi chinh. File .env bi gitignore, KHONG commit.
# Cac gia tri mac dinh duoi day khop voi docker-compose.yml o goc repo.

# Port API (macOS: 5000 bi AirPlay chiem)
PORT=4000

# Postgres. Production: dat mat khau manh, KHONG dung store/store
DATABASE_URL=postgres://store:store@localhost:5432/store
# Database cho npm test (bi xoa sach moi lan chay test)
TEST_DATABASE_URL=postgres://store:store@localhost:5432/store_test

# Cac origin duoc gui request ghi (chong CSRF), phan cach bang dau phay.
# Production: dat dung domain web, vi du https://library.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production => cookie dang nhap co co Secure (bat buoc HTTPS). De trong khi dev.
# NODE_ENV=production

# Thu muc du lieu (de trong = mac dinh <repo>/source/3DSMOOD va <repo>/storage)
# SOURCE_DIR=
# STORAGE_DIR=
