# Copy thanh .env roi chinh. File .env bi gitignore, KHONG commit.
# Cac gia tri mac dinh duoi day khop voi docker-compose.yml o goc repo.

# Port API (macOS: 5000 bi AirPlay chiem)
PORT=4000

# Postgres. Production: dat mat khau manh, KHONG dung store/store
DATABASE_URL=postgres://store:store@localhost:5432/store
# Dedicated disposable test database only; NEVER point at production.
TEST_DATABASE_URL=postgres://store:store@localhost:5432/store_test

# Cac origin duoc gui request ghi (chong CSRF), phan cach bang dau phay.
# Production: dat dung domain web, vi du https://library.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production => cookie dang nhap co co Secure (bat buoc HTTPS). De trong khi dev.
# NODE_ENV=production

# Server-only JWT HS256 signing key: exactly 32 random bytes encoded as base64.
# Generate with node crypto.randomBytes(32).toString('base64'); never expose to clients.
# Preserve across restarts; changing it requires users to log in again.
JWT_SECRET=

# Thu muc du lieu (de trong = mac dinh <repo>/source/3DSMOOD va <repo>/storage)
# SOURCE_DIR=
# STORAGE_DIR=

# Licensing: two DISTINCT CSPRNG secrets, each exactly 32 bytes encoded as base64.
# Generate locally using node crypto.randomBytes(32).toString('base64'); never commit.
# Back these up securely: changing either breaks verification/decryption of existing keys.
LICENSE_HMAC_SECRET=
LICENSE_ENCRYPTION_KEY=
# Bootstrap an administrator explicitly: register the owner account, verify its UUID,
# then set it here. Never use a shared/default administrator password.
LICENSE_ADMIN_USER_IDS=

# Single Lifetime product; exactly 2000 VND, controlled by the server.
LICENSE_PRICE_VND=2000
PUBLIC_BASE_URL=http://localhost:5173
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/license
PAYOS_CANCEL_URL=http://localhost:5173/license
# Public HTTPS endpoint; registration is a separate explicit operator action.
PAYOS_WEBHOOK_URL=

# Default dev bind is loopback. Put production behind an HTTPS reverse proxy.
HOST=127.0.0.1
# Only when behind a known reverse proxy, e.g. 127.0.0.1/32,::1/128.
# Keep empty when directly exposed. Restrict upstream ingress at the firewall.
TRUST_PROXY=
# Production runs migrations separately with a migration role; dev runs on startup.
# RUN_MIGRATIONS=false

CATALOG_PROVIDER=r2
# Account ID is optional and is only checked by the optional webhook adapter.
R2_ACCOUNT_ID=
R2_BUCKET=3dsmood-models-prod
R2_SYNC_ROOT_PREFIX=3DSMOOD/
# S3 API endpoint from the bucket settings. Never use a public r2.dev URL.
R2_ENDPOINT=
R2_REGION=auto
# Runtime uses ONLY these bucket-scoped Object Read credentials.
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
# Optional upload/admin credentials; backend production does not load these.
# R2_WRITE_ACCESS_KEY_ID=
# R2_WRITE_SECRET_ACCESS_KEY=
# Free-tier catalog sync uses a full metadata listing at this interval.
R2_SYNC_ENABLED=true
R2_SYNC_INTERVAL_SECONDS=600
R2_SYNC_ON_STARTUP=true
R2_SYNC_BATCH_SIZE=1000
# Event delivery stays disabled unless an operator explicitly enables the adapter.
R2_WEBHOOK_ENABLED=false
# Only read when R2_WEBHOOK_ENABLED=true. Keep private.
R2_EVENT_WEBHOOK_SECRET=

# ---- v3 / P1: Google Drive (docs/drive-setup.md) ----
# Operator OAuth client (Google Cloud Console > Credentials > OAuth client ID, type "Web application").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be registered EXACTLY in the OAuth client. https only, except http://localhost for development.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/admin/drive/oauth/callback
# Encrypts the stored refresh token (AES-256-GCM). 32 random bytes, base64. Back it up: losing it forces a reconnect.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_KEY=
# Where the browser is sent after Google's redirect (admin UI origin).
ADMIN_UI_URL=http://localhost:5173
