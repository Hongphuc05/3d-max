# Copy thanh .env roi chinh. File .env bi gitignore, KHONG commit.
# Cac gia tri mac dinh duoi day khop voi docker-compose.yml o goc repo.

# Port API (macOS: 5000 bi AirPlay chiem)
PORT=4000

# Postgres. Production: dat mat khau manh, KHONG dung store/store
DATABASE_URL=postgres://store:store@localhost:5432/store
# Dedicated disposable test database only; NEVER point at production.
TEST_DATABASE_URL=postgres://store:store@localhost:5432/store_test

# Cac origin duoc gui request ghi (chong CSRF), phan cach bang dau phay.
# Production: dat dung domain web, vi du https://library.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# production => cookie dang nhap admin co co Secure (bat buoc HTTPS). De trong khi dev.
# NODE_ENV=production

# Server-only JWT HS256 signing key: exactly 32 random bytes encoded as base64.
# Generate with node crypto.randomBytes(32).toString('base64'); never expose to clients.
# Preserve across restarts; changing it requires users to log in again.
JWT_SECRET=

# Thu muc du lieu (de trong = mac dinh <repo>/storage): previews-v3/, model-cache/
# STORAGE_DIR=

# Default dev bind is loopback. Put production behind an HTTPS reverse proxy.
HOST=127.0.0.1
# Only when behind a known reverse proxy, e.g. 127.0.0.1/32,::1/128.
# Keep empty when directly exposed. Restrict upstream ingress at the firewall.
TRUST_PROXY=
# Production runs migrations separately with a migration role; dev runs on startup.
# RUN_MIGRATIONS=false

# Quet Drive bang API key (docs/drive-setup.md). Thu muc goc phai chia se "Anyone with the link". Khong commit.
DRIVE_API_KEY=

# v3 P4.2: ban sao model tren dia VPS (D26). Tat ca tuy chon; mac dinh trong ngoac.
# MODEL_CACHE_DIR=            (<STORAGE_DIR>/model-cache)
# MODEL_CACHE_MAX_BYTES=      (21474836480 = 20 GiB)
# MODEL_CACHE_MIN_FREE_BYTES= (2147483648 = 2 GiB dung luong trong toi thieu)
# MODEL_MAX_FILE_BYTES=       (4294967296 = 4 GiB)
# DOWNLOAD_SESSIONS_PER_HOUR= (10 phien/gio/thiet bi)
# DOWNLOAD_MAX_CONCURRENT=    (3 luot tai dong thoi toan he thong)

# v3 P5: bot Telegram bao chu cua hang ve don can xac nhan. De TRONG het = tat (don chi xac nhan duoc o trang admin).
# Da dien thi phai dien du 4 bien, neu khong server KHONG khoi dong (loi chi neu ten bien, khong in gia tri).
# Token tu @BotFather. Khong commit.
TELEGRAM_BOT_TOKEN=
# chat_id cua chu cua hang (so nguyen), nhieu nguoi thi ngan cach bang dau phay. Chi nhung nguoi nay bam duoc nut.
TELEGRAM_OWNER_CHAT_IDS=
# 16-256 ky tu A-Z a-z 0-9 _ - ; Telegram gui lai trong header X-Telegram-Bot-Api-Secret-Token. PHAI khac TELEGRAM_WEBHOOK_PATH.
TELEGRAM_WEBHOOK_SECRET=
# Chuoi ngau nhien trong duong dan webhook: POST /api/telegram/webhook/<path>. Sai path -> 404.
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_PATH=
# Chi dung cho scripts/telegram-set-webhook.js: goc HTTPS cong khai cua API (khong co duong dan), vd https://api.example.com
# TELEGRAM_WEBHOOK_BASE_URL=
