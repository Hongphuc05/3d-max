{
  "name": "store-api",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --env-file-if-exists=.env scripts/ingest.js",
    "check:drive": "node --env-file-if-exists=.env scripts/check-drive.js --download-archive",
    "sync:drive": "node --env-file-if-exists=.env scripts/sync-drive.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../../storage/license-dev.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "express": "^5.1.0",
    "googleapis": "^188.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
