{
  "name": "store-api",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --env-file-if-exists=.env scripts/ingest.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../../storage/license-dev.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=../../storage/license-dev.env --test --test-concurrency=1",
    "check:r2": "node --env-file-if-exists=.env scripts/check-r2.js",
    "sync:r2": "node --env-file-if-exists=.env --env-file-if-exists=../../storage/license-dev.env scripts/sync-r2.js",
    "seed:legacy": "node --env-file-if-exists=.env scripts/seed-legacy-catalog.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@payos/node": "^2.0.5",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
