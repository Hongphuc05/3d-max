<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PlatformSetup</AssemblyName>
    <RootNamespace>Setup</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- source có tiếng Việt và không có BOM -> ép csc đọc UTF-8 -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- payload.zip do build-installer.ps1 sinh ra ngay trước khi build -->
    <EmbeddedResource Include="payload.zip" LogicalName="Setup.payload.zip" />
  </ItemGroup>

</Project>
